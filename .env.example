# Copier ce fichier en apps/api/.env pour lancer l'API en local.

# Obligatoires : sans eux, l'API refuse de démarrer.
# Hash : pnpm --filter @portfolio-matis/api hash-password
ADMIN_PASSWORD_HASH=
# Secret de session, au moins 32 caractères : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Adresse de l'interface d'administration, seule origine autorisée à écrire.
ADMIN_ORIGIN=http://localhost:5173

# Facultatifs (valeurs par défaut indiquées).
# DATABASE_PATH=data/data.db
# MEDIA_DIR=data/media
# PORT=3000

# En local seulement, car le cookie Secure demande HTTPS.
COOKIE_SECURE=false

# Sites à redéployer à la publication, et jeton GitHub limité à ces dépôts (Actions : lecture et écriture).
# DEPLOY_SITES=[{"name":"classique","repo":"Matis-Wostry/cv","workflow":"deploy.yml","ref":"main"}]
# GITHUB_DISPATCH_TOKEN=

# Formulaire de contact du site : tout ou rien. Pour Gmail, un mot de passe d'application (voir docs/deploiement.md).
# CONTACT_ORIGINS=http://127.0.0.1:8080
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=matiswostry.pro@gmail.com
# SMTP_PASSWORD=
# SMTP_PORT=465
# CONTACT_TO=